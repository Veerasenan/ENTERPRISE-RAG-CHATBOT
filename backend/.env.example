# ==============================
# PostgreSQL (identity & roles DB)
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag_db
DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/enterprise_rag_db

# ==============================
# JWT Auth
# ==============================
JWT_SECRET_KEY=replace-with-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ==============================
# LLM Provider: Google Gemini (only supported provider)
# ==============================
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001

# ==============================
# App configuration
# ==============================
APP_NAME=Enterprise RAG Chatbot
APP_ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================
# Storage (documents & vectors)
# ==============================
UPLOAD_DIR=./data/uploaded_pdfs
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=company_policies

# ==============================
# Chunking / Retrieval
# ==============================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_FILE_SIZE_MB=25

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_PER_MINUTE=30
